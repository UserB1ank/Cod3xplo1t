# Only build inputs are sent to Docker; local state and credentials stay out.
*
!go.mod
!go.sum
!cmd
!internal
!migrations
!web
!contracts
!pkg
!plugins
!scripts
scripts/*
!scripts/package-joern.py
!runtime
!runtime/pi-worker
!runtime/pi-worker/package.json
!runtime/pi-worker/package-lock.json
!runtime/pi-worker/tsconfig.json
!runtime/pi-worker/src
web/node_modules
web/dist
**/.env
**/.env.*
**/*.pem
**/*.key
**/.ssh
**/id_rsa*
**/id_ed25519*
**/*.db
**/*.db-*
**/.DS_Store
runtime/pi-worker/node_modules
runtime/pi-worker/dist

# Never send nested local CLI workspaces or Python caches as build inputs.
**/.codexploit
**/__pycache__
**/*.pyc
