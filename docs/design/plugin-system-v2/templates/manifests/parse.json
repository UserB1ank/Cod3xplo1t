{
  "api_version": "codexploit/plugin/v2",
  "id": "example.parse",
  "version": "0.1.0",
  "name": "代码解析开发模板",
  "description": "仅为接口声明模板；未提供可执行实现，不可登记为已实测。",
  "languages": [
    "Go"
  ],
  "runtime": {
    "kind": "process",
    "protocol": "codexploit/process-plugin/v2",
    "entrypoint": "bin/adapter"
  },
  "permissions": {
    "network": "none",
    "source_write": false,
    "target_execution": false
  },
  "operations": [
    {
      "id": "execute",
      "stage": "parse",
      "capability": "parse",
      "profile": "standard",
      "inputs": [
        {
          "name": "source",
          "kind": "source.snapshot",
          "schema_id": "codexploit/source-tar/v1",
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "code",
          "kind": "code.facts",
          "schema_id": "codexploit/code-facts/v2",
          "cardinality": "one",
          "required": true
        }
      ],
      "config_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  ]
}
