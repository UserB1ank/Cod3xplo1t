{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexploit.invalid/proposals/plugin-v2/manifest.schema.json",
  "title": "Proposed black-box plugin manifest; not a production API schema",
  "type": "object",
  "required": [
    "api_version",
    "id",
    "version",
    "name",
    "description",
    "languages",
    "runtime",
    "permissions",
    "operations"
  ],
  "properties": {
    "api_version": {
      "const": "codexploit/plugin/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "kind",
        "protocol"
      ],
      "properties": {
        "kind": {
          "enum": [
            "process",
            "native_service",
            "agent_runtime",
            "environment_backend",
            "verification_executor"
          ]
        },
        "protocol": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/v[0-9]+$"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_/-]+(?:\\.exe)?$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "process"
              }
            }
          },
          "then": {
            "required": [
              "entrypoint"
            ]
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "required": [
        "network",
        "source_write",
        "target_execution"
      ],
      "properties": {
        "network": {
          "enum": [
            "none",
            "restricted"
          ]
        },
        "source_write": {
          "const": false
        },
        "target_execution": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "entrypoint"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "port": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "schema_id",
        "cardinality",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
        },
        "schema_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/v[0-9]+$"
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "stage",
        "capability",
        "profile",
        "inputs",
        "outputs",
        "config_schema"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "stage": {
          "enum": [
            "source",
            "parse",
            "semantic",
            "scan",
            "path.generate",
            "path.enhance",
            "agent",
            "environment",
            "verification",
            "report"
          ]
        },
        "capability": {
          "enum": [
            "agent",
            "environment",
            "parse",
            "path",
            "report",
            "scan",
            "semantic",
            "source",
            "verification"
          ]
        },
        "profile": {
          "enum": [
            "standard",
            "native"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "config_schema": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
