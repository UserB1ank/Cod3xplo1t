{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexploit.invalid/contracts/v1/path-proposal.schema.json",
  "title": "Agent path proposal request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_key", "entry_ref", "target_ref", "basis", "evidence"],
  "properties": {
    "request_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "entry_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "target_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "basis": {"enum": ["call_reachability", "hypothesis"]},
    "steps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "from_ref", "to_ref", "relation_ref"],
        "properties": {
          "layer": {"const": "asg"},
          "from_ref": {"type": "string", "minLength": 1, "maxLength": 512},
          "to_ref": {"type": "string", "minLength": 1, "maxLength": 512},
          "relation_ref": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["source", "symbol", "call_site", "asg_node", "evidence", "artifact"]},
          "id": {"type": "string", "minLength": 1, "maxLength": 512},
          "file": {"type": "string", "minLength": 1, "maxLength": 1024},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "related_path_ids": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "max_per_run": {"type": "integer", "minimum": 1, "maximum": 32}
  }
}
