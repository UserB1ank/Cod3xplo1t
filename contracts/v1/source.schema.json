{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexploit.invalid/contracts/v1/source.schema.json",
  "title": "Source definition",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "codexploit/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "kind": {
      "enum": [
        "local_folder",
        "git_repository",
        "uploaded_archive"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "ref": {
      "type": "string",
      "maxLength": 256
    },
    "credential_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "snapshot": {
      "type": "string"
    },
    "files": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "description": "Immutable source definition version pinned during capture",
      "type": "integer",
      "minimum": 1
    },
    "import": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "zip",
            "tar",
            "tar.gz"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "excluded": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        }
      },
      "required": [
        "format",
        "sha256",
        "bytes",
        "files",
        "skipped",
        "excluded"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "id",
    "project_id",
    "name",
    "kind",
    "location",
    "ref"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "local_folder"
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "pattern": "^/repos/.+",
            "allOf": [
              {
                "not": {
                  "pattern": "(^|/)\\.\\.?(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "[\\\\\u0000]"
                }
              },
              {
                "not": {
                  "pattern": "//"
                }
              },
              {
                "not": {
                  "pattern": "/$"
                }
              }
            ]
          },
          "ref": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "git_repository"
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "pattern": "^(https|ssh)://[^/@?#]+/[^?#]*$"
          },
          "ref": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "uploaded_archive"
          }
        }
      },
      "then": {
        "required": [
          "import"
        ],
        "properties": {
          "location": {
            "pattern": "^upload:[a-f0-9]{64}$"
          },
          "ref": {
            "const": ""
          }
        },
        "not": {
          "required": [
            "credential_ref"
          ]
        }
      }
    }
  ]
}
