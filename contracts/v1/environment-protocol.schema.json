{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexploit.invalid/contracts/v1/environment-protocol.schema.json",
  "title": "Environment backend request and receipt",
  "description": "Domain protocol between the verifier and an environment backend. It is deliberately separate from the plugin Execute protocol: the provider owns provisioning and destruction, and the receipt records the limits actually applied.",
  "oneOf": [
    { "$ref": "#/$defs/Request" },
    { "$ref": "#/$defs/Receipt" }
  ],
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "digest", "read_only"],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "read_only": { "const": true }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_digest", "source", "owner", "required_capabilities"],
      "properties": {
        "schema_version": { "const": "codexploit/environment-request/v1" },
        "plan_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "plan_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source": { "$ref": "#/$defs/Source" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
        "required_capabilities": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 100 } },
        "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "network": { "enum": ["none", "restricted"] }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "environment_id", "provider", "provider_version", "applied", "network_mode", "source_digest", "source_read_only", "digest"],
      "properties": {
        "schema_version": { "const": "codexploit/environment-receipt/v1" },
        "environment_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "provider_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "applied": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 100 } },
        "network_mode": { "enum": ["none", "restricted"] },
        "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_read_only": { "const": true },
        "image_digest": { "type": "string", "maxLength": 200 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
