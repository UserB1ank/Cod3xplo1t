{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexploit.invalid/contracts/v1/workflow.schema.json",
  "title": "Typed plugin DAG",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "codexploit/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "enum": [
          "source.snapshot",
          "code.ast",
          "code.facts",
          "security.facts",
          "scanner.alerts",
          "discovery.paths",
          "discovery.findings",
          "knowledge.view",
          "report.document"
        ]
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,49}$"
          },
          "plugin_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)+$"
          },
          "plugin_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "config": {
            "type": "object"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 600
          }
        },
        "required": [
          "id",
          "plugin_id",
          "plugin_version",
          "needs",
          "config",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "api_version",
    "id",
    "version",
    "name",
    "description",
    "inputs",
    "nodes"
  ],
  "additionalProperties": false
}
