{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexploit.invalid/contracts/v1/verification-protocol.schema.json",
  "title": "Verification plan and evidence",
  "description": "Versioned verification domain protocol. The host validates approval, environment and evidence; an executor reports observations, never a confirmed verdict.",
  "oneOf": [
    { "$ref": "#/$defs/Plan" },
    { "$ref": "#/$defs/Evidence" }
  ],
  "$defs": {
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "argv", "timeout_seconds", "expectation"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "enum": ["command", "http", "static_query"] },
        "argv": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 500 } },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "expectation": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_digest", "hypothesis_id", "steps", "required_capabilities"],
      "properties": {
        "schema_version": { "const": "codexploit/verification-plan/v1" },
        "plan_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "plan_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hypothesis_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/Step" } },
        "required_capabilities": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 100 } },
        "approval": { "type": "string", "maxLength": 200 }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "evidence_id", "run_id", "plan_digest", "kind", "command", "exit_code", "output_digest", "source"],
      "properties": {
        "schema_version": { "const": "codexploit/verification-evidence/v1" },
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "plan_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kind": { "enum": ["runtime_log", "test", "http", "static_query"] },
        "command": { "type": "string", "maxLength": 2000 },
        "exit_code": { "type": "integer", "minimum": -1 },
        "timed_out": { "type": "boolean" },
        "output_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "limitations": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 500 } },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshot_id", "digest"],
          "properties": {
            "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    }
  }
}
