{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexploit.invalid/contracts/v1/storage.schema.json",
  "title": "Storage adapter profile",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "codexploit/v1"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "driver": {
          "enum": [
            "postgresql",
            "sqlite",
            "custom"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "credential_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "driver",
        "host",
        "port",
        "database",
        "credential_ref"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "driver": {
          "enum": [
            "volume",
            "s3"
          ]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "driver",
        "endpoint",
        "bucket"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "driver": {
          "const": "relational"
        }
      },
      "required": [
        "driver"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "database_service": {
          "type": "string",
          "minLength": 1
        },
        "artifact_service": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "database_service",
        "artifact_service"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "metadata",
    "artifacts",
    "graph",
    "deployment"
  ],
  "additionalProperties": false
}
