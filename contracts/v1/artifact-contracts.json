{
  "api_version": "codexploit/contracts/v1",
  "capabilities": [
    {"key": "source", "label": "源码接入"},
    {"key": "parse", "label": "解析"},
    {"key": "semantic", "label": "语义"},
    {"key": "scan", "label": "扫描"},
    {"key": "path", "label": "路径"},
    {"key": "agent", "label": "Agent"},
    {"key": "environment", "label": "环境供应"},
    {"key": "verification", "label": "验证"},
    {"key": "report", "label": "报告"}
  ],
  "contracts": [
    {"kind": "source.snapshot", "capability": "source", "schemas": ["codexploit/source-tar/v1", "codexploit/source-files/v1"]},
    {"kind": "code.ast", "capability": "parse", "schemas": ["codexploit/go-ast/v1"]},
    {"kind": "code.facts", "capability": "parse", "schemas": ["codexploit/go-facts/v1"]},
    {"kind": "security.facts", "capability": "semantic", "schemas": ["codexploit/go-facts/v1", "codexploit/discovery/v1"]},
    {"kind": "scanner.alerts", "capability": "scan", "schemas": ["codexploit/scanner-alerts/v1"]},
    {"kind": "discovery.paths", "capability": "path", "schemas": ["codexploit/discovery/v1"]},
    {"kind": "discovery.findings", "capability": "report", "schemas": ["codexploit/report-input/v1", "codexploit/discovery/v1"]},
    {"kind": "report.document", "capability": "report", "schemas": ["codexploit/builtin-native/v1", "codexploit/report/v1"]}
  ]
}
